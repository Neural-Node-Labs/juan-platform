
JUAN_PROVIDER=deepseek


# ── LLM Provider API Keys ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
GROQ_API_KEY=your_groq_key_here
MISTRAL_API_KEY=your_mistral_key_here
COHERE_API_KEY=your_cohere_key_here
TOGETHER_API_KEY=your_together_key_here
FIREWORKS_API_KEY=your_fireworks_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
XAI_API_KEY=your_xai_key_here
GEMINI_API_KEY=your_gemini_key_here
CUSTOM_API_KEY=your_custom_api_key_here

# ── Generic fallback (optional) ────────────────────────────────────────────────
JUAN_API_KEY=your_generic_fallback_key_here

# ── Local LLM Providers (no keys needed) ───────────────────────────────────────
# OLLAMA runs on http://localhost:11434/v1
# LMSTUDIO runs on http://localhost:1234/v1