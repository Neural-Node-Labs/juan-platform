# ── LLM Provider Keys ─────────────────────────────────────────────────────────
# At least one provider key is required.
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME

# Optional additional providers (used for fallback or direct routing)
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...
# TOGETHER_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...

# ── Agent Configuration ───────────────────────────────────────────────────────
JUAN_MODEL=claude-sonnet-4-20250514
JUAN_PROVIDER=anthropic
MAX_ITERATIONS=90

# ── Platform / Gateway ────────────────────────────────────────────────────────
# Uncomment and set to enable Telegram integration
# JUAN_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
# JUAN_PLATFORM=telegram

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=5000

# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET=changeme-replace-with-64-char-random-string

# Optional: password-protect the dashboard
# DASHBOARD_PASSWORD=your-strong-password

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── React / Kivy UI Gateway ───────────────────────────────────────────────────
UI_WS_PORT=5001
UI_HTTP_PORT=5002

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
UI_SECRET=changeme-replace-with-64-char-random-string

# Optional: password to protect the React/Kivy UI (same for both clients)
# UI_PASSWORD=your-strong-password

# Rate limit: messages per minute per session (default 60)
# UI_RATE_LIMIT_RPM=60

# Token TTL in seconds (default 86400 = 24h)
# UI_TOKEN_TTL=86400

# Allowed CORS origins for the React app (comma-separated)
# UI_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ── UI Mode ───────────────────────────────────────────────────────────────────
# Controls which UI is served at http://localhost:5000/
#
#   react   → React TypeScript SPA served at /  (Python dashboard moved to /ops)
#   python  → Python HTML dashboard at /        (React still at /chat if built)
#   both    → Python dashboard at /  AND React at /chat  (default)
#
UI_MODE=both

# ── Workspace ─────────────────────────────────────────────────────────────────
# Directory where the agent reads/writes files.
# In Docker this is inside the juan-data volume at /data/workspace.
# On the host you can access it via: docker exec juan-agent ls /data/workspace
# Or copy files out: docker cp juan-agent:/data/workspace ./local-workspace
JUAN_WORKSPACE=/data/workspace

# ── Swarm ─────────────────────────────────────────────────────────────────────
# Max agents the swarm tool can spawn per call (hard cap is 8)
# SWARM_MAX_AGENTS=4
