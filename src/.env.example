# ── LLM Provider Keys ─────────────────────────────────────────────────────────
# At least one provider key is required.
ANTHROPIC_API_KEY=sk-ant-api03-CHANGE_ME

# Optional additional providers (used for fallback or direct routing)
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# MISTRAL_API_KEY=...
# TOGETHER_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...

# ── Agent Configuration ───────────────────────────────────────────────────────
JUAN_MODEL=claude-sonnet-4-20250514
JUAN_PROVIDER=anthropic
MAX_ITERATIONS=90

# ── Platform / Gateway ────────────────────────────────────────────────────────
# Uncomment and set to enable Telegram integration
# JUAN_BOT_TOKEN=1234567890:ABCDefGhIJKlmNoPQRsTUVwxyZ
# JUAN_PLATFORM=telegram

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=5000

# Generate a strong secret: python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET=changeme-replace-with-64-char-random-string

# Optional: password-protect the dashboard
# DASHBOARD_PASSWORD=your-strong-password

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
